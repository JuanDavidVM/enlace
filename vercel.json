{
  "version": 2,
  "functions": {
    "api/chat.js":    { "memory": 256, "maxDuration": 30 },
    "api/log.js":     { "memory": 256, "maxDuration": 10 },
    "api/reports.js": { "memory": 256, "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/chat",    "destination": "/api/chat.js" },
    { "source": "/api/log",     "destination": "/api/log.js" },
    { "source": "/api/reports", "destination": "/api/reports.js" },
    { "source": "/(.*)",        "destination": "/public/$1" }
  ]
}
